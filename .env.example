# Copied by docker-compose.yml to configure the Postgres container and to
# build each service's DATABASE_URL. Copy to .env before running `docker compose up`.
POSTGRES_USER=pulseops
POSTGRES_PASSWORD=pulseops
POSTGRES_DB=pulseops

# RabbitMQ now runs in the cloud (CloudAMQP) rather than as a container, so
# this is a real credential and MUST come from your gitignored .env - never
# commit the populated value.
#
# It is injected into the order-service and worker containers by
# docker-compose. Note that services/*/.env files are NOT visible to the
# containers (the Dockerfiles copy only package.json and src/), so putting
# it there alone is not enough - those files are for running a service
# directly on the host with `npm start`.
RABBITMQ_URL=amqps://user:password@host.lmq.cloudamqp.com/vhost
