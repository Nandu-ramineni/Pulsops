{
  "uid": "pulseops-dependencies",
  "title": "PulseOps / Dependencies",
  "tags": ["pulseops"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "PostgreSQL Query Duration (p95)",
      "description": "By service and operation. \"operation\" is a hand-assigned label (insert_order, get_user, ...), not raw SQL.",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(db_query_duration_seconds_bucket[5m])) by (le, service, operation))",
          "legendFormat": "{{service}} / {{operation}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "PostgreSQL Connection Pool",
      "description": "Live pg.Pool state per service. Reads 0 whenever no query has run in the last ~10s (pool's idleTimeoutMillis) - that's correct pool behavior.",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "db_pool_connections",
          "legendFormat": "{{service}} / {{state}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Redis Cache Hit Ratio",
      "description": "order-service's user-profile cache-aside lookup.",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(cache_hits_total[5m])) / (sum(rate(cache_hits_total[5m])) + sum(rate(cache_misses_total[5m])))",
          "legendFormat": "hit ratio"
        }
      ]
    },
    {
      "id": 4,
      "title": "Redis Operation Latency (p95)",
      "type": "timeseries",
      "gridPos": { "x": 8, "y": 8, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(cache_operation_duration_seconds_bucket[5m])) by (le, operation))",
          "legendFormat": "{{operation}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "user-service Dependency Call Latency (p95)",
      "description": "order-service's outbound call to user-service on a cache miss - the \"which downstream call is slow\" signal.",
      "type": "timeseries",
      "gridPos": { "x": 16, "y": 8, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(dependency_request_duration_seconds_bucket[5m])) by (le, dependency))",
          "legendFormat": "{{dependency}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Queue Backlog Trend (derived proxy)",
      "description": "NOT true queue depth. RabbitMQ moved to CloudAMQP, so the broker-native rabbitmq_queue_messages metric is no longer scraped - see the KNOWN GAP note in observability/prometheus/prometheus.yml. This derives the trend from the app side instead: publish rate minus consume rate. Above zero means the queue is growing faster than the worker drains it; sustained time above zero is the backlog signal. It cannot show absolute depth, and it cannot see messages that were already queued before this window - restoring that needs CloudAMQP's own metrics endpoint.",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(queue_messages_published_total{status=\"success\"}[5m])) - sum(rate(queue_messages_consumed_total[5m]))",
          "legendFormat": "net growth (publish - consume)"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(queue_messages_published_total{status=\"success\"}[5m]))",
          "legendFormat": "published/s"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(queue_messages_consumed_total[5m]))",
          "legendFormat": "consumed/s"
        }
      ]
    },
    {
      "id": 7,
      "title": "Worker Processing Rate",
      "description": "Messages consumed/sec off order.created, by outcome.",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "ops", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(queue_messages_consumed_total[5m])) by (status)",
          "legendFormat": "{{status}}"
        }
      ]
    }
  ]
}
